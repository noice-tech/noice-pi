{
  "name": "@noice-tech/pi-changelog",
  "version": "1.2.1",
  "description": "Preview unreleased changes and write privacy-safe release notes in Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "changelog",
    "release-notes"
  ],
  "files": [
    "prompts/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noice-tech/noice-pi.git",
    "directory": "packages/changelog"
  },
  "homepage": "https://github.com/noice-tech/noice-pi/tree/main/packages/changelog#readme",
  "bugs": {
    "url": "https://github.com/noice-tech/noice-pi/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && node ../../scripts/smoke-pack.mjs @noice-tech/pi-changelog packages/changelog"
  },
  "dependencies": {
    "@noice-tech/pi-commit": "workspace:*"
  },
  "bundledDependencies": [
    "@noice-tech/pi-commit"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./node_modules/@noice-tech/pi-commit/extensions/commit/index.ts"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  }
}
